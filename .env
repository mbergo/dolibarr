# Dolibarr Docker Environment Configuration
# Copy this file to .env and customize the values

# ============================================
# General Configuration
# ============================================
TZ=America/New_York

# ============================================
# Database Configuration
# ============================================
MYSQL_ROOT_PASSWORD=dolibarr_root_pwd
MYSQL_DATABASE=dolibarr
MYSQL_USER=dolibarr
MYSQL_PASSWORD=dolibarr_pwd
DB_PORT=3306

# ============================================
# Dolibarr Database Connection
# ============================================
DOLI_DB_TYPE=mysqli
DOLI_DB_HOST=mariadb
DOLI_DB_PORT=3306
DOLI_DB_NAME=dolibarr
DOLI_DB_USER=dolibarr
DOLI_DB_PASSWORD=dolibarr_pwd
DOLI_DB_ROOT_LOGIN=root
DOLI_DB_ROOT_PASSWORD=dolibarr_root_pwd

# ============================================
# Dolibarr Configuration
# ============================================
# Admin credentials
DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=admin123

# URL configuration
DOLI_URL_ROOT=http://localhost:8080
DOLI_NOCSRFCHECK=0

# Company information
DOLI_COMPANY_NAME=My Company
DOLI_COMPANY_COUNTRY_CODE=US

# Installation mode (1 for auto-install, 0 for manual)
DOLI_INSTALL_AUTO=1

# Development mode (1 for development, 0 for production)
DOLI_DEV_MODE=0

# ============================================
# PHP Configuration
# ============================================
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX=20M
PHP_POST_MAX=25M

# ============================================
# Port Configuration
# ============================================
# Web application port
WEB_PORT=8080

# PHPMyAdmin port (optional tool)
PMA_PORT=8081

# Maildev ports (optional tool)
MAIL_SMTP_PORT=1025
MAIL_WEB_PORT=8082

# Redis port (optional cache)
REDIS_PORT=6379

# ============================================
# Docker Configuration
# ============================================
# Compose project name
COMPOSE_PROJECT_NAME=dolibarr

# Host user/group IDs (for Linux permission issues)
# Uncomment and set to your user's UID/GID if needed
# HOST_USER_ID=1000
# HOST_GROUP_ID=1000
